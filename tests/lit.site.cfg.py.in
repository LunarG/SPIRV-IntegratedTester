# Generated by CMake from tests/lit.site.cfg.py.in. Do not edit.
#
# This file holds only what differs between build directories: where the
# tools are. Everything else lives in the checked-in tests/lit.cfg.py.

config.sit_src_root = r"@CMAKE_SOURCE_DIR@"
config.sit_obj_root = r"@CMAKE_BINARY_DIR@"

# Substitution name (without the %) -> path. An empty path means the tool was
# not found at configure time.
config.sit_tools = {
    "slangc":    r"@SLANG_EXE@",
    "glslang":   r"@GLSLANG_EXE@",
    "dxc":       r"@DXC_EXE@",
    "spirv_dis": r"@SPIRV_DIS_EXE@",
    "spirv_opt": r"@SPIRV_OPT_EXE@",
    "spirv_val": r"@SPIRV_VAL_EXE@",
    "check":     r"@FILECHECK_EXE@",
}

lit_config.load_config(config, r"@CMAKE_SOURCE_DIR@/tests/lit.cfg.py")
