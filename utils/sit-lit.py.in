#   sit-lit.py -v  <source>/tests/slang/example.slang  # one test, by its source path
#   sit-lit.py --watch -sv <source>/tests              # rerun on every change
# Every other option is a normal lit option (see "sit-lit.py --help").

import os
import sys

SRC_ROOT = r"@CMAKE_SOURCE_DIR@"
OBJ_ROOT = r"@CMAKE_BINARY_DIR@"
LIT_PYTHONPATH = r"@LIT_PYTHONPATH@"

if LIT_PYTHONPATH:
    sys.path.insert(0, LIT_PYTHONPATH)
sys.path.insert(0, os.path.join(SRC_ROOT, "utils"))

if "--watch" in sys.argv[1:]:
    import sit.watch

    lit_args = [arg for arg in sys.argv[1:] if arg != "--watch"]
    sys.exit(sit.watch.main(os.path.abspath(__file__), SRC_ROOT, OBJ_ROOT, lit_args))

import lit.main
import lit.util

# lit finds tests/lit.cfg.py when it is given a path in the source tree. This
# map makes it load the generated site config for this build directory
# instead, which then loads tests/lit.cfg.py with the tool paths filled in.
# The key must be normalized the same way lit normalizes the path it finds.
config_map = {
    os.path.normcase(lit.util.abs_path_preserve_drive(
        os.path.join(SRC_ROOT, "tests", "lit.cfg.py"))):
        os.path.join(OBJ_ROOT, "tests", "lit.site.cfg.py"),
}

lit.main.main({"config_map": config_map})
