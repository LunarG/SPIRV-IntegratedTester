"""
SPIR-V Integrated Tester — generated configuration file.
Do not edit this file directly; edit sit.cfg.py.in in the source tree instead.

This file is generated by CMake into the build directory with tool paths
resolved at configure time.
"""

import shutil

config.name = "SPIRV-IntegratedTester"

# Root directory to search for test files (relative to source tree).
config.test_dir = "@CMAKE_SOURCE_DIR@/tests"

# Extensions to treat as test files.
config.suffixes = [".glsl", ".hlsl", ".slang", ".spvasm"]

# ---------------------------------------------------------------------------
# Tool paths — injected by CMake at configure time.
# ---------------------------------------------------------------------------

# Required tools.
_slangc      = "@SLANG_EXE@"
_spirv_dis  = "@SPIRV_DIS_EXE@"
_spirv_opt  = "@SPIRV_OPT_EXE@"
_spirv_val  = "@SPIRV_VAL_EXE@"
_filecheck  = "@FILECHECK_EXE@"

# Optional tools — empty string if not found at configure time.
_glslang = "@GLSLANG_EXE@"
_dxc     = "@DXC_EXE@"

# ---------------------------------------------------------------------------
# Substitutions
# ---------------------------------------------------------------------------
config.substitutions = [
    ("%slangc",     _slangc),
    ("%spirv_dis", _spirv_dis),
    ("%spirv_opt", _spirv_opt),
    ("%spirv_val", _spirv_val),
    ("%check",     _filecheck),
]

if _glslang:
    config.substitutions.append(("%glslang", _glslang))
if _dxc:
    config.substitutions.append(("%dxc", _dxc))
